agent:
  name: Бетси
  gender: female              # female|male|neutral
  personality:
    tone: friendly        # friendly|professional|casual|sassy
    style: detailed       # concise|detailed|balanced
    custom_instructions: |
      Ты умная и весёлая помощница.

security:
  password_hash: ""       # генерируется визардом
  tools:
    shell: true
    ssh: false
    browser: true
    npm_install: true

llm:
  provider: openrouter
  api_key: YOUR_OPENROUTER_API_KEY
  fast_model: google/gemini-2.5-flash
  strong_model: anthropic/claude-sonnet-4
  # fallback_models:                           # Free models for when balance runs out
  #   - qwen/qwen3-coder:free
  #   - nvidia/nemotron-3-super-120b-a12b:free
  #   - mistralai/mistral-small-3.1-24b-instruct:free
  #   - meta-llama/llama-3.3-70b-instruct:free

channels:
  browser:
    enabled: true
  telegram:
    enabled: false
    token: YOUR_TELEGRAM_BOT_TOKEN
  max:
    enabled: false

# Канал Битрикс24. Раскомментируйте и заполните своими значениями.
# client_id/client_secret — со страницы приложения в портале; это секреты,
# держите их только здесь и не выкладывайте в репозиторий.
# bitrix:
#   webhook_url: "https://ВАШ-ПОРТАЛ.bitrix24.ru/rest/1/YOUR_WEBHOOK_CODE/"
#   application_token: YOUR_BITRIX_APPLICATION_TOKEN   # нужен только до установки приложения
#   bot_id: "0"                                        # выдаётся scripts/register-bitrix-bot.mjs
#   client_id: YOUR_BITRIX_CLIENT_ID
#   client_secret: YOUR_BITRIX_CLIENT_SECRET

plugins:
  voice:
    enabled: false
  video:
    enabled: false
  selfies:
    enabled: false
    # fal_api_key: "key-..."
    # reference_photo_url: "https://..."
